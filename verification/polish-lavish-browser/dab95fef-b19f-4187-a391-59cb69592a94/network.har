            "mimeType": "text/html",
            "size": 1552,
            "text": "<!doctype html><html lang=\"zh\"><head><meta charset=\"utf-8\"><title>Polish 隔离网页验收</title><style>body{font:18px/1.7 system-ui;background:#f5f6f7;color:#1f2329;margin:0;padding:40px}main{background:white;padding:30px;max-width:780px;border:1px solid #ddd;border-radius:12px}button,input{font:inherit}label{display:block;margin:15px 0}button{padding:8px 16px;background:#3370ff;color:white;border:0;border-radius:6px}</style></head><body><main><h1>虚构项目：花园计划</h1><p id=\"anchor\">第一阶段整理花园布局，请在这里定位评论。</p><p>第二阶段选择植物并核对浇水安排。</p><form data-lavish-question=\"note\" id=\"native-form\" onsubmit=\"event.preventDefault();window.lavish.queuePrompt('表单意见：'+document.getElementById('note').value,{scope:'session',data:{note:document.getElementById('note').value}});window.lavish.sendQueuedPrompts()\"><label>原生表单意见<input id=\"note\" name=\"note\" placeholder=\"输入虚构意见\"></label><button id=\"submit-native\" type=\"submit\">提交表单</button></form></main><script src=\"/sdk.js?key=265f3c362066cc23&artifact_revision=2&artifact_load_token=fU-83FO63cd5w2sqXSo68n66Ekt3z_Qd\"></script></body></html>"
