            "mimeType": "text/css",
            "size": 180,
            "text": "body.polish {\n  color-scheme: light;\n  --bg: #f5f6f8;\n  --bg-panel: #fff;\n  --bg-elevated: #f5f6f8;\n  --fg: #1f2329;\n  --fg-faint: #646a73;\n  --border: #dee0e3;\n  --accent: #3370ff;\n  --accent-hover: #245bdb;\n  --brass-ink: #fff;\n  font-family:\n    system-ui,\n    -apple-system,\n    \"Segoe UI\",\n    sans-serif;\n}\n.polish .bar {\n  background: #fff;\n  color: #1f2329;\n  border-bottom: 1px solid #dee0e3;\n  gap: 12px;\n}\n.polish .brand-mark {\n  color: #3370ff;\n  font-family: system-ui, sans-serif;\n  font-style: normal;\n  font-weight: 600;\n}\n.polish .ended-title {\n  font-family: system-ui, sans-serif;\n  font-style: normal;\n}\n.polish .brand-support {\n  display: none;\n}\n.polish .sidebar {\n  position: fixed !important;\n  right: 16px;\n  top: 66px;\n  bottom: 18px;\n  width: min(420px, calc(100vw - 32px)) !important;\n  z-index: 45;\n  border: 1px solid #dee0e3;\n  border-radius: 12px;\n  box-shadow: 0 12px 48px #1f232926;\n  background: white;\n}\n.polish #panel {\n  position: fixed;\n  right: 16px;\n  top: 66px;\n  bottom: 18px;\n  width: min(420px, calc(100vw - 32px));\n  z-index: 45;\n  border: 1px solid #dee0e3;\n  border-radius: 12px;\n  box-shadow: 0 12px 48px #1f232926;\n  background: #fff;\n}\n.polish .layout {\n  grid-template-columns: minmax(0, 1fr) !important;\n}\n.polish .main {\n  width: 100%;\n}\n.polish #presenceBanner {\n  display: none;\n}\n.polish-controls {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  font: 13px/1.5 system-ui;\n}\n.polish-controls button,\n#polish-dialog button {\n  border: 1px solid #dee0e3;\n  border-radius: 6px;\n  background: #fff;\n  color: #3370ff;\n  padding: 6px 12px;\n  cursor: pointer;\n  font: inherit;\n}\n#polish-status {\n  color: #646a73;\n}\n.polish-controls .processing {\n  color: #c76a0b;\n}\n#polish-dialog {\n  position: fixed;\n  z-index: 10000;\n  width: min(380px, calc(100vw - 24px));\n  max-height: calc(100vh - 88px);\n  overflow: auto;\n  padding: 16px;\n  border: 1px solid #dee0e3;\n  border-radius: 12px;\n  background: #fff;\n  color: #1f2329;\n  box-shadow: 0 12px 48px #1f232926;\n  font:\n    14px/1.6 system-ui,\n    -apple-system,\n    sans-serif;\n  box-sizing: border-box;\n}\n#polish-dialog[hidden] {\n  display: none;\n}\n.polish-head {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n.polish-head strong {\n  flex: 1;\n}\n.polish-head label {\n  font-size: 12px;\n  color: #646a73;\n  display: flex;\n  align-items: center;\n  gap: 5px;\n}\n#polish-close {\n  padding: 2px 8px !important;\n  font-size: 24px !important;\n  border: 0 !important;\n  color: #8f959e !important;\n}\n#polish-threads {\n  width: 100%;\n  margin: 12px 0 4px;\n  padding: 6px;\n  border: 1px solid #dee0e3;\n  border-radius: 6px;\n  background: white;\n  color: #646a73;\n  font: 12px system-ui;\n}\n#polish-quote {\n  margin: 12px 0;\n  padding: 0 10px;\n  border-left: 3px solid #dee0e3;\n  color: #8f959e;\n  font-size: 12px;\n  max-height: 72px;\n  overflow: auto;\n}\n#polish-history {\n  max-height: 220px;\n  overflow: auto;\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n}\n#polish-history p {\n  padding: 10px;\n  margin: 8px 0;\n  border-radius: 6px;\n  background: #f5f6f8;\n}\n#polish-history .polish-agent {\n  background: #eff4ff;\n}\n#polish-message-status {\n  font-size: 12px;\n  color: #646a73;\n  margin: 12px 0;\n}\n#polish-input {\n  width: 100%;\n  min-height: 100px;\n  padding: 10px;\n  border: 1px solid #dee0e3;\n  border-radius: 6px;\n  font: 14px/1.6 system-ui;\n  resize: vertical;\n  box-sizing: border-box;\n  background: white;\n  color: #1f2329;\n}\n#polish-input:focus {\n  outline: 2px solid #3370ff33;\n  border-color: #3370ff;\n}\n.polish-foot {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-top: 8px;\n  gap: 8px;\n}\n.polish-foot span {\n  font-size: 11px;\n  color: #8f959e;\n}\n#polish-send {\n  background: #3370ff !important;\n  color: white !important;\n  border-color: #3370ff !important;\n}\n#polish-dialog button:disabled,\n.polish-controls button:disabled {\n  opacity: 0.5;\n  cursor: default;\n}\n#polish-error {\n  font-size: 12px;\n  color: #b42318;\n  white-space: pre-wrap;\n}\n@media (max-width: 760px) {\n  .polish .brand {\n    display: none;\n  }\n  .polish-controls {\n    gap: 6px;\n  }\n  .polish-controls button {\n    font-size: 12px;\n    padding: 5px 7px;\n  }\n  #polish-status {\n    display: none;\n  }\n  .polish #panel {\n    top: 64px;\n    bottom: 12px;\n  }\n}\n"
